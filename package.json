{
  "name": "apartment-management",
  "version": "0.1.0",
  "private": true,
  "description": "Apartment Management — Maintenance module (CSE327). HTML/CSS frontend, Node.js REST API, PostgreSQL.",
  "main": "server/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "db:create": "node db/create-db.js",
    "db:migrate": "node db/migrate.js",
    "db:reset": "node db/migrate.js --reset",
    "db:seed": "node db/seed.js",
    "db:backup": "node db/backup.js",
    "user:password": "node db/set-password.js",
    "check:speed": "node scripts/check-speed.js",
    "lint": "eslint . && stylelint \"public/css/**/*.css\"",
    "format": "prettier --write \"server/**/*.js\" \"db/**/*.js\" \"scripts/**/*.js\" \"public/js/*.js\"",
    "docs": "jsdoc -c jsdoc.json",
    "test": "node --test"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "motion": "^14.12.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
