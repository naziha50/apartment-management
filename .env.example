# Copy this file to .env and adjust it for your machine. Never commit .env.
PORT=3000
NODE_ENV=development

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# On macOS (Homebrew) the user is usually your login name with no password.
# On Windows/Linux it is often: postgres://postgres:yourpassword@localhost:5432/apartment_maintenance
DATABASE_URL=postgres://localhost:5432/apartment_maintenance
